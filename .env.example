# Names only. Real values go in Vercel project env vars, never in git.
# Public receive address for USDC on Base (an address, NEVER a private key or seed phrase)
X402_PAY_TO=
# cdp = Coinbase CDP facilitator (required for Bazaar listing); public-testnet = x402.org, Base Sepolia only
X402_FACILITATOR=public-testnet
# eip155:84532 = Base Sepolia (testnet), eip155:8453 = Base mainnet
X402_NETWORK=eip155:84532
# CDP Secret API key (portal.cdp.coinbase.com), needed only when X402_FACILITATOR=cdp
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
