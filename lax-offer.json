    {
      "skill_id": "kes-fx-rates",
      "description": "GET /v1/fx/kes: Official CBK Kenya shilling rates for up to 21 currencies, latest or any date since 2004-11-02.",
      "pricing": {
        "model": "per_call",
        "amount": "0.003",
        "currency": "USDC",
        "rail": "x402"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "description": "One or more ISO codes, comma-separated: USD, GBP, EUR, ZAR, UGX, TZS, RWF, BIF, AED, CAD, CHF, JPY, SEK, NOK, DKK, INR, HKD, SGD, SAR, CNY, AUD. Omit for all 21"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD (Nairobi). Omit for the latest. Weekends/holidays return the last published rate with is_fallback=true"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "base": {
            "const": "KES"
          },
          "requested_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_defaulted_to_today": {
            "type": "boolean"
          },
          "rates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "rate_date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "is_fallback": {
                  "type": "boolean"
                },
                "fallback_reason": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quote": {
                  "type": "string"
                },
                "mean": {
                  "type": "number"
                },
                "buy": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sell": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "kes_per_unit": {
                  "type": "number"
                },
                "units_per_kes": {
                  "type": "number"
                }
              },
              "required": [
                "currency",
                "name",
                "rate_date",
                "is_fallback",
                "fallback_reason",
                "quote",
                "mean",
                "buy",
                "sell",
                "kes_per_unit",
                "units_per_kes"
              ]
            }
          },
          "freshness": {
            "type": "object",
            "properties": {
              "snapshot_last_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "live_check": {
                "enum": [
                  "not_needed",
                  "fetched",
                  "cached",
                  "failed"
                ]
              }
            },
            "required": [
              "snapshot_last_date",
              "live_check"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
